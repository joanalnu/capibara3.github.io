---
import BaseLayout from "./BaseLayout.astro"
import Icon from "../components/Icon.astro"
const { page, html, section = "Documentation" } = Astro.props
---
<BaseLayout title={page.title} description={page.description || `${section} resource from CAPIBARA.`} currentSlug={section.toLowerCase()}>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <a class="back-link" href={section === "GAMMA" ? "/gamma" : "/documentation"}><Icon name="arrow" size={15} /> {section} overview</a>
      <div class="aside-rule"></div>
      <p class="eyebrow">{section} library</p>
      <p class="aside-note">A structured, living resource for the CAPIBARA collaboration.</p>
      <a class="aside-cta" href="/join-us">Get involved <Icon name="arrow" size={14} /></a>
    </aside>
    <article class="docs-article">
      <header class="article-header">
        <p class="eyebrow">{section}{page.date ? ` · ${page.date}` : ""}</p>
        <h1>{page.title}</h1>
        {page.description && <p class="article-lede">{page.description}</p>}
      </header>
      <div class="prose" set:html={html} />
    </article>
  </div>
</BaseLayout>
