---
import BaseLayout from "./BaseLayout.astro"
import Icon from "../components/Icon.astro"
const { page, html } = Astro.props
---
<BaseLayout title={page.title} description={page.description || "CAPIBARA collaboration resource."} currentSlug={page.slug}>
  <div class="content-shell">
    <aside class="content-aside">
      <a class="back-link" href="/"><Icon name="arrow" size={15} /> Back to overview</a>
      <div class="aside-rule"></div>
      <p class="eyebrow">{page.category}</p>
      <p class="aside-note">A living resource from the CAPIBARA collaboration.</p>
      <a class="aside-cta" href="/join-us">Get involved <Icon name="arrow" size={14} /></a>
    </aside>
    <article class="article">
      <header class="article-header">
        <p class="eyebrow">{page.category}{page.date ? ` · ${page.date}` : ""}</p>
        <h1>{page.title}</h1>
        {page.description && <p class="article-lede">{page.description}</p>}
      </header>
      <div class="prose" set:html={html} />
    </article>
  </div>
</BaseLayout>
