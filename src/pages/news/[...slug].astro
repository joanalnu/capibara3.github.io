---
import { getNewsPages } from "../../lib/content"
export function getStaticPaths() {
  return getNewsPages().map((page) => ({
    params: { slug: page.slug.replace(/^news\//, "") },
    props: { destination: `/blog/${page.slug.replace(/^news\//, "")}` },
  }))
}
const { destination } = Astro.props
---
<meta http-equiv="refresh" content={`0;url=${destination}`} />
<script define:vars={{ destination }}>window.location.replace(destination)</script>
