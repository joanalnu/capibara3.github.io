---
import DocsLayout from "../../layouts/DocsLayout.astro"
import { getPagesBySection, renderMarkdown } from "../../lib/content"
export async function getStaticPaths() {
  return Promise.all(getPagesBySection("documentation").filter((page) => page.slug !== "documentation").map(async (page) => ({ params: { slug: page.slug.replace(/^documentation\//, "") }, props: { page, html: await renderMarkdown(page.body) } })))
}
const { page, html } = Astro.props
---
<DocsLayout page={page} html={html} />
