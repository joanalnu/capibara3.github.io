---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Icon from "../../components/Icon.astro"
import { getPagesBySection } from "../../lib/content"
const pages = getPagesBySection("documentation").filter((page) => page.slug !== "documentation")
const groups = [...new Set(pages.map((page) => page.id.split("/")[1]))]
---
<BaseLayout title="Documentation" description="Onboarding, governance, and technical documentation for CAPIBARA." currentSlug="documentation">
  <section class="library-hero page-width"><p class="eyebrow"><span class="eyebrow-dot"></span> CAPIBARA handbook</p><h1>Build the knowledge<br /><em>to reach orbit.</em></h1><p>Everything you need to join the collaboration, work with the team, and contribute to a real student-led space programme.</p></section>
  <section class="docs-index page-width">
    {groups.map((group) => <div class="docs-group"><p class="eyebrow">{group.replace(/^\d+_/, "").replace(/_/g, " ")}</p><div class="docs-links">{pages.filter((page) => page.id.split("/")[1] === group).map((page) => <a href={`/${page.slug}`}><span>{page.title}</span><Icon name="arrow" size={16} /></a>)}</div></div>)}
  </section>
</BaseLayout>
