---
import ContentLayout from "../layouts/ContentLayout.astro"
import { getPages, renderMarkdown } from "../lib/content"

export async function getStaticPaths() {
  return Promise.all(
    getPages()
      .filter((page) => !page.slug.startsWith("news") && !page.slug.startsWith("documentation") && !page.slug.startsWith("gamma"))
      .map(async (page) => ({
        params: { slug: page.slug },
        props: { page, html: await renderMarkdown(page.body) },
      })),
  )
}

const { page, html } = Astro.props
---
<ContentLayout page={page} html={html} />
